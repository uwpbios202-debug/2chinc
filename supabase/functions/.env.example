SEND_EMAIL_HOOK_SECRET=v1,whsec_ZGV2LW9ubHktbG9jYWwtaG9vay1zZWNyZXQtMTIzNDU2Nzg=
CONDO_REMINDER_SECRET=dev-only-reminder-secret

PORTAL_BASE_URL=http://localhost:8000/owners/
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
STAFF_NOTIFY_EMAIL=info@2ndchinc.org
MAIL_FROM=2nd Chance Housing <info@2ndchinc.org>
